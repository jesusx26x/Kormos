# Copia este archivo como .env y rellena los valores.
# Clave larga y aleatoria para firmar las sesiones del panel:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Base de datos local (SQLite). Al publicar: PostgreSQL.
DATABASE_URI=file:./data/sitio.db
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Correo (avisos a suscriptores y recuperar contraseña). Vacío en local: los
# correos solo se escriben en la consola. Se llena al publicar (Fase 11).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=
