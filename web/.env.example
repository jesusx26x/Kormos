# Copia este archivo como .env y rellena los valores.
# Clave larga y aleatoria para firmar las sesiones del panel:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Base de datos local (SQLite). Al publicar: PostgreSQL.
DATABASE_URI=file:./data/sitio.db
NEXT_PUBLIC_SITE_URL=http://localhost:3000
