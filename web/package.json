{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "node --env-file-if-exists=.env --import tsx/esm scripts/payload-cli.mjs",
    "generate:types": "node --env-file-if-exists=.env --import tsx/esm scripts/payload-cli.mjs generate:types",
    "generate:importmap": "node --env-file-if-exists=.env --import tsx/esm scripts/payload-cli.mjs generate:importmap",
    "seed": "node --env-file-if-exists=.env --import tsx/esm scripts/seed.mts",
    "migrate": "node --env-file-if-exists=.env --import tsx/esm scripts/payload-cli.mjs migrate",
    "migrate:create": "node --env-file-if-exists=.env --import tsx/esm scripts/payload-cli.mjs migrate:create",
    "vercel-build": "npm run migrate && npm run archivos:reparar && next build",
    "archivos:reparar": "node --env-file-if-exists=.env --import tsx/esm scripts/reparar-archivos.mts",
    "contenido:exportar": "node --env-file-if-exists=.env --import tsx/esm scripts/pasar-a-la-nube.mts exportar",
    "contenido:importar": "node --env-file=.env.nube --import tsx/esm scripts/pasar-a-la-nube.mts importar",
    "migrate:nube": "node --env-file=.env.nube --import tsx/esm scripts/payload-cli.mjs migrate",
    "contenido:respaldo": "node --env-file=.env.nube --import tsx/esm scripts/pasar-a-la-nube.mts exportar"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/db-sqlite": "^3.91.0",
    "@payloadcms/email-resend": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/storage-vercel-blob": "^3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "^3.91.0",
    "@vercel/blob": "^2.3.1",
    "graphql": "^16.14.2",
    "next": "16.4.2",
    "payload": "^3.91.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "potrace": "^2.1.8",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
